{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here only so src/browser-api.ts can name Notification and window.isSecureContext.
    // That file also compiles for the renderer, which already supplies these types.
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist-electron",
    "types": ["node"]
  },
  "include": [
    "electron/**/*.cts",
    "shared/**/*.ts",
    "src/browser-api.ts",
    "scripts/**/*.cts",
    "test/**/*.cts"
  ]
}