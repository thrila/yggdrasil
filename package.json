{
  "name": "opportunity-dashboard",
  "productName": "Yggdrasil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "sources:verify": "node scripts/verify-sources.cjs",
    "sources:catalog": "node scripts/build-source-catalog.cjs",
    "sources:install": "node scripts/install-sources.cjs",
    "collect": "node scripts/index-opportunities.cjs",
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "build:cloudflare": "npm run build:web && node scripts/build-cloudflare.mjs",
    "deploy:web": "npm run build:cloudflare && cf deploy --prebuilt --mode production",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.5",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "dev.local.yggdrasil",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ]
  }
}
