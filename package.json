{
  "name": "opportunity-dashboard",
  "productName": "Yggdrasil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dist": "vite build && electron-builder"
  },
  "dependencies": { "fast-xml-parser": "^4.5.0", "react": "^18.3.1", "react-dom": "^18.3.1", "react-feather": "^2.0.10" },
  "devDependencies": { "@vitejs/plugin-react": "^4.3.1", "concurrently": "^9.0.0", "electron": "^33.0.0", "electron-builder": "^25.0.0", "vite": "^5.4.0", "wait-on": "^8.0.0" },
  "build": { "appId": "dev.local.yggdrasil", "icon": "build/icon.png", "directories": { "output": "release" }, "files": ["dist/**", "electron/**", "package.json"] }
}
